# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0c1014"

# Main text color
theme[main_fg]="#c8cbce"

# Title color for boxes
theme[title]="#c8cbce"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#83bdf8"

# Background color of selected item in processes box
theme[selected_bg]="#2d4054"

# Foreground color of selected item in processes box
theme[selected_fg]="#83bdf8"

# Color of inactive/disabled text
theme[inactive_fg]="#737d88"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#aeb1b5"

# Background color of the percentage meters
theme[meter_bg]="#2d4054"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#aeb1b5"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#b7a7c8"
theme[mem_box]="#a2c5b7"
theme[net_box]="#d88e8b"
theme[proc_box]="#83bdf8"

# Box divider line and small boxes line color
theme[div_line]="#737d88"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#a2c5b7"
theme[temp_mid]="#e0d19a"
theme[temp_end]="#d88e8b"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#93c6d6"
theme[cpu_mid]="#8eaacf"
theme[cpu_end]="#b7a7c8"

# Mem/Disk free meter
theme[free_start]="#b7a7c8"
theme[free_mid]="#8eaacf"
theme[free_end]="#93c6d6"

# Mem/Disk cached meter
theme[cached_start]="#8eaacf"
theme[cached_mid]="#93c6d6"
theme[cached_end]="#b7a7c8"

# Mem/Disk available meter
theme[available_start]="#e0d19a"
theme[available_mid]="#d88e8b"
theme[available_end]="#d88e8b"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#a2c5b7"
theme[used_mid]="#93c6d6"
theme[used_end]="#8eaacf"

# Download graph colors
theme[download_start]="#e0d19a"
theme[download_mid]="#d88e8b"
theme[download_end]="#d88e8b"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#a2c5b7"
theme[upload_mid]="#93c6d6"
theme[upload_end]="#8eaacf"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#93c6d6"
theme[process_mid]="#8eaacf"
theme[process_end]="#b7a7c8"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#0c1014"
theme[gradient_color_1]="#191d22"
theme[gradient_color_2]="#2d4054"
theme[gradient_color_3]="#737d88"
theme[gradient_color_4]="#868a8d"
theme[gradient_color_5]="#c8cbce"
theme[gradient_color_6]="#aeb1b5"
theme[gradient_color_7]="#dfe1e4"

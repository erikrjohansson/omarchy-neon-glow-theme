# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#061214"

# Main text color
theme[main_fg]="#c7cbcc"

# Title color for boxes
theme[title]="#c7cbcc"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#0acde9"

# Background color of selected item in processes box
theme[selected_bg]="#074650"

# Foreground color of selected item in processes box
theme[selected_fg]="#0acde9"

# Color of inactive/disabled text
theme[inactive_fg]="#698186"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#adb2b3"

# Background color of the percentage meters
theme[meter_bg]="#074650"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#adb2b3"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#a7a6cb"
theme[mem_box]="#85cbad"
theme[net_box]="#eb817f"
theme[proc_box]="#0acde9"

# Box divider line and small boxes line color
theme[div_line]="#698186"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#85cbad"
theme[temp_mid]="#e6d17f"
theme[temp_end]="#eb817f"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#6cccd9"
theme[cpu_mid]="#e37cbf"
theme[cpu_end]="#a7a6cb"

# Mem/Disk free meter
theme[free_start]="#a7a6cb"
theme[free_mid]="#e37cbf"
theme[free_end]="#6cccd9"

# Mem/Disk cached meter
theme[cached_start]="#e37cbf"
theme[cached_mid]="#6cccd9"
theme[cached_end]="#a7a6cb"

# Mem/Disk available meter
theme[available_start]="#e6d17f"
theme[available_mid]="#eb817f"
theme[available_end]="#eb817f"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#85cbad"
theme[used_mid]="#6cccd9"
theme[used_end]="#e37cbf"

# Download graph colors
theme[download_start]="#e6d17f"
theme[download_mid]="#eb817f"
theme[download_end]="#eb817f"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#85cbad"
theme[upload_mid]="#6cccd9"
theme[upload_end]="#e37cbf"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#6cccd9"
theme[process_mid]="#e37cbf"
theme[process_end]="#a7a6cb"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#061214"
theme[gradient_color_1]="#131f22"
theme[gradient_color_2]="#074650"
theme[gradient_color_3]="#698186"
theme[gradient_color_4]="#838a8c"
theme[gradient_color_5]="#c7cbcc"
theme[gradient_color_6]="#adb2b3"
theme[gradient_color_7]="#dee2e3"

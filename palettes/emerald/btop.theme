# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0b110a"

# Main text color
theme[main_fg]="#c9cbc8"

# Title color for boxes
theme[title]="#c9cbc8"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#83ce6e"

# Background color of selected item in processes box
theme[selected_bg]="#2d4626"

# Foreground color of selected item in processes box
theme[selected_fg]="#83ce6e"

# Color of inactive/disabled text
theme[inactive_fg]="#727f6f"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#afb2ae"

# Background color of the percentage meters
theme[meter_bg]="#2d4626"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#afb2ae"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#bda6b5"
theme[mem_box]="#9bcc97"
theme[net_box]="#eb817f"
theme[proc_box]="#83ce6e"

# Box divider line and small boxes line color
theme[div_line]="#727f6f"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#9bcc97"
theme[temp_mid]="#e6d17f"
theme[temp_end]="#eb817f"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#82ccc2"
theme[cpu_mid]="#87adc2"
theme[cpu_end]="#bda6b5"

# Mem/Disk free meter
theme[free_start]="#bda6b5"
theme[free_mid]="#87adc2"
theme[free_end]="#82ccc2"

# Mem/Disk cached meter
theme[cached_start]="#87adc2"
theme[cached_mid]="#82ccc2"
theme[cached_end]="#bda6b5"

# Mem/Disk available meter
theme[available_start]="#e6d17f"
theme[available_mid]="#eb817f"
theme[available_end]="#eb817f"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#9bcc97"
theme[used_mid]="#82ccc2"
theme[used_end]="#87adc2"

# Download graph colors
theme[download_start]="#e6d17f"
theme[download_mid]="#eb817f"
theme[download_end]="#eb817f"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#9bcc97"
theme[upload_mid]="#82ccc2"
theme[upload_end]="#87adc2"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#82ccc2"
theme[process_mid]="#87adc2"
theme[process_end]="#bda6b5"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#0b110a"
theme[gradient_color_1]="#191f17"
theme[gradient_color_2]="#2d4626"
theme[gradient_color_3]="#727f6f"
theme[gradient_color_4]="#868a85"
theme[gradient_color_5]="#c9cbc8"
theme[gradient_color_6]="#afb2ae"
theme[gradient_color_7]="#e0e2df"
